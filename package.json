{
  "name": "daywell",
  "version": "1.2.0",
  "description": "Private Android food, Indian meal planning and adaptable training with optional ChatGPT",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run tests/domain.test.ts",
    "test:e2e": "playwright test",
    "android:sync": "npm run build && cap sync android",
    "android:build": "npm run android:sync && cd android && gradlew.bat assembleDebug"
  },
